{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissões mínimas dos post-its: eventos, arrastar e os comandos do app.",
  "local": true,
  "windows": ["note-*"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "allow-hide-window",
    "allow-get-shortcut-status",
    "allow-get-window-state",
    "allow-open-note-window",
    "allow-close-note-window",
    "allow-get-last-note",
    "allow-get-note",
    "allow-save-note",
    "allow-list-notes",
    "allow-search-notes",
    "allow-delete-note",
    "allow-restore-note",
    "allow-purge-note"
  ]
}
