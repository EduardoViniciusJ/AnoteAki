{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnoteAki",
  "version": "0.1.0",
  "identifier": "com.anoteaki.desktop",
  "build": {
    "beforeDevCommand": { "script": "npm --prefix ../frontend run dev", "cwd": "." },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": { "script": "npm --prefix ../frontend run build", "cwd": "." },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnoteAki",
        "width": 360,
        "height": 320
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "EduardoViniciusJ",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
