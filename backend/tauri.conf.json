{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnoteAki",
  "version": "0.1.0",
  "identifier": "com.anoteaki.desktop",
  "build": {
    "beforeDevCommand": {
      "script": "npm --prefix ../frontend run dev",
      "cwd": "."
    },
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": {
      "script": "npm --prefix ../frontend run build",
      "cwd": "."
    },
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AnoteAki",
        "width": 360,
        "height": 320,
        "minWidth": 280,
        "minHeight": 200,
        "resizable": true,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ],
      "csp": "default-src 'self'; script-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'; style-src 'self'; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; script-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-src 'none'; object-src 'none'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "EduardoViniciusJ",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
